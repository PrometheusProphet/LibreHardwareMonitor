<Window x:Class="ComputerVitals.Wpf.ConnectedHardwareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ComputerVitals.Wpf"
        Title="Connected hardware"
        Icon="Assets/computer-vitals.ico"
        Width="980"
        Height="680"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Padding="16,6" Click="Refresh_Click" Content="Refresh inventory" />
            <Button x:Name="FocusRecognizedDeviceButton"
                    DockPanel.Dock="Right"
                    Margin="0,0,8,0"
                    Padding="16,6"
                    Click="FocusRecognizedDevice_Click"
                    Content="Focus recognized device"
                    Visibility="Collapsed" />
            <Button x:Name="ShowAllDevicesButton"
                    DockPanel.Dock="Right"
                    Margin="0,0,8,0"
                    Padding="16,6"
                    Click="ShowAllDevices_Click"
                    Content="Show all devices"
                    Visibility="Collapsed" />
            <Button DockPanel.Dock="Right"
                    Margin="0,0,8,0"
                    Padding="16,6"
                    Click="IncidentTimeline_Click"
                    Content="Incident timeline" />
            <StackPanel>
                <local:SelectableText FontSize="28" FontWeight="SemiBold" Text="Connected hardware" />
                <local:SelectableText Margin="0,6,0,0"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           Text="Read-only local inventory. Device relationships and unknown fields remain visible." />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="14" BorderThickness="1" CornerRadius="10">
                <TreeView x:Name="DeviceTree"
                          SelectedItemChanged="DeviceTree_SelectedItemChanged">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type local:HardwareInventoryViewItem}" ItemsSource="{Binding Children}">
                            <StackPanel Margin="0,4">
                                <local:SelectableText FontWeight="SemiBold" Text="{Binding DisplayName, Mode=OneWay}" TextWrapping="Wrap" />
                                <local:SelectableText FontSize="12"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                           Text="{Binding Summary, Mode=OneWay}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </Border>

            <Border Grid.Column="2" Padding="20" BorderThickness="1" CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <local:SelectableText x:Name="DetailsTitle" FontSize="22" FontWeight="SemiBold" Text="Select a component" TextWrapping="Wrap" />
                        <local:SelectableText x:Name="DetailsRole"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                   TextWrapping="Wrap" />
                        <Separator Margin="0,18,0,14" />
                        <local:SelectableText x:Name="DetailsText" TextWrapping="Wrap" />
                        <Separator Margin="0,18,0,14" />
                        <local:SelectableText x:Name="OfficialSupportText" TextWrapping="Wrap" />
                        <Button x:Name="OpenOfficialSupportButton"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                Padding="16,6"
                                Click="OpenOfficialSupport_Click"
                                Visibility="Collapsed" />
                        <Separator Margin="0,18,0,14" />
                        <local:SelectableText x:Name="OfficialUpdateText" TextWrapping="Wrap" />
                        <Button x:Name="OpenOfficialUpdateButton"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                Padding="16,6"
                                Click="OpenOfficialUpdate_Click"
                                Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="4">
            <local:SelectableText x:Name="StatusText" Text="Preparing read-only hardware inventory…" TextWrapping="Wrap" />
            <local:SelectableText x:Name="EvidenceText"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
