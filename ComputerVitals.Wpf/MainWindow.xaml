<Window x:Class="ComputerVitals.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ComputerVitals.Wpf"
        Title="Computer Vitals prototype"
        Icon="Assets/computer-vitals.ico"
        Width="860"
         Height="680"
         MinWidth="720"
         MinHeight="660"
         WindowStartupLocation="CenterScreen"
         KeyboardNavigation.TabNavigation="Continue"
         FocusManager.FocusedElement="{Binding ElementName=ThresholdTextBox}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <local:SelectableText FontSize="28" FontWeight="SemiBold" Text="Temperature health" />
            <local:SelectableText Margin="0,6,0,0"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       Text="Read-only CPU and GPU observations. Missing or failed readings stay visible." />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="CpuCard" Grid.Column="0" Padding="20" BorderThickness="1" CornerRadius="12">
                <StackPanel>
                    <DockPanel>
                        <local:SelectableText FontSize="14" FontWeight="SemiBold" Text="CPU" />
                        <local:SelectableText x:Name="CpuStateText" DockPanel.Dock="Right" TextAlignment="Right" />
                    </DockPanel>
                    <local:SelectableText x:Name="CpuValueText" Margin="0,20,0,0" FontSize="40" FontWeight="SemiBold" Text="—" />
                    <local:SelectableText x:Name="CpuNameText" Margin="0,10,0,0" FontWeight="SemiBold" Text="Discovering…" TextWrapping="Wrap" />
                    <local:SelectableText x:Name="CpuSourceText" Margin="0,6,0,0" Text="Source: —" TextWrapping="Wrap" />
                    <local:SelectableText x:Name="CpuRangeText" Margin="0,6,0,0" Text="Session range: —" />
                    <local:SelectableText x:Name="CpuFreshnessText" Margin="0,6,0,0" Text="Freshness: —" />
                    <local:SelectableText x:Name="CpuReasonText" Margin="0,14,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border x:Name="GpuCard" Grid.Column="2" Padding="20" BorderThickness="1" CornerRadius="12">
                <StackPanel>
                    <DockPanel>
                        <local:SelectableText FontSize="14" FontWeight="SemiBold" Text="GPU" />
                        <local:SelectableText x:Name="GpuStateText" DockPanel.Dock="Right" TextAlignment="Right" />
                    </DockPanel>
                    <local:SelectableText x:Name="GpuValueText" Margin="0,20,0,0" FontSize="40" FontWeight="SemiBold" Text="—" />
                    <local:SelectableText x:Name="GpuNameText" Margin="0,10,0,0" FontWeight="SemiBold" Text="Discovering…" TextWrapping="Wrap" />
                    <local:SelectableText x:Name="GpuSourceText" Margin="0,6,0,0" Text="Source: —" TextWrapping="Wrap" />
                    <local:SelectableText x:Name="GpuRangeText" Margin="0,6,0,0" Text="Session range: —" />
                    <local:SelectableText x:Name="GpuFreshnessText" Margin="0,6,0,0" Text="Freshness: —" />
                    <local:SelectableText x:Name="GpuReasonText" Margin="0,14,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4" Padding="16" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <local:SelectableText Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Threshold °C" />
                <TextBox x:Name="ThresholdTextBox" Grid.Column="1" VerticalContentAlignment="Center" ToolTip="No alert is enabled until you enter a threshold."
                         AutomationProperties.Name="Temperature alert threshold"
                         AutomationProperties.HelpText="Enter a temperature in degrees Celsius. This does not assert a universally safe threshold."
                         TabIndex="0" />
                <local:SelectableText Grid.Column="3" Margin="0,0,8,0" VerticalAlignment="Center" Text="Persist seconds" />
                <TextBox x:Name="PersistenceTextBox" Grid.Column="4" Text="30" VerticalContentAlignment="Center"
                         AutomationProperties.Name="Alert persistence seconds"
                         AutomationProperties.HelpText="Enter how many seconds a threshold reading must persist before alert evaluation."
                         TabIndex="1" />
                <local:SelectableText Grid.Column="6" Margin="0,0,8,0" VerticalAlignment="Center" Text="Hysteresis °C" />
                <TextBox x:Name="HysteresisTextBox" Grid.Column="7" Text="3" VerticalContentAlignment="Center"
                         AutomationProperties.Name="Alert hysteresis degrees Celsius"
                         AutomationProperties.HelpText="Enter the degrees Celsius below the threshold required before the alert can clear."
                         TabIndex="2" />
                <Button Grid.Column="9" Padding="18,6" Click="ApplyAlert_Click" Content="Apply alert"
                        AutomationProperties.Name="Apply temperature alert settings"
                        AutomationProperties.HelpText="Applies the entered threshold, persistence, and hysteresis settings."
                        TabIndex="3" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="6">
            <Button DockPanel.Dock="Right" Padding="16,6" Click="Refresh_Click" Content="Refresh now"
                    AutomationProperties.Name="Refresh temperature observations"
                    AutomationProperties.HelpText="Refreshes read-only CPU and GPU temperature observations."
                    TabIndex="5" />
            <Button DockPanel.Dock="Right"
                     Margin="0,0,8,0"
                     Padding="16,6"
                     Click="ConnectedHardware_Click"
                     Content="Connected hardware"
                     AutomationProperties.Name="Open connected hardware"
                     AutomationProperties.HelpText="Opens the read-only local hardware inventory."
                     TabIndex="4" />
            <StackPanel>
                <local:SelectableText x:Name="StatusText" Text="Starting read-only sensor probe…" TextWrapping="Wrap" />
                <local:SelectableText x:Name="NotificationStatusText"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
